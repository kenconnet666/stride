<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stride.Core.Assets.Editor.ViewModels.Progress"
        xmlns:gsvw="using:Stride.GameStudio.Avalonia.Views"
        x:Class="Stride.GameStudio.Avalonia.Views.ProgressWindow"
        x:DataType="vm:WorkProgressViewModel"
        Title="{Binding Title}" Width="640" Height="480"
        WindowStartupLocation="CenterOwner">
  <gsvw:ProgressView/>
</Window>
