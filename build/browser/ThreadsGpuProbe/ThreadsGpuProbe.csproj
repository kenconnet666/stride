<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- Can the engine live on a worker? A managed thread with its own JavaScript interop gets the canvas of the page
       as an OffscreenCanvas, draws on it with WebGPU from its own animation frames, and calls managed code that uses
       Stride's thread pool, synchronously, each frame. Serve it cross-origin isolated (validate-threads.cjs). -->
  <PropertyGroup>
    <TargetFramework>net11.0-browser</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <WasmEnableThreads>true</WasmEnableThreads>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../sources/core/Stride.Core/Stride.Core.csproj" AdditionalProperties="StridePlatforms=Browser;StrideSkipAutoPack=true;StrideAssemblyProcessorFramework=net10.0" />
    <!-- JSWebWorker is not in the reference assembly yet: it is called by reflection, and kept through trimming -->
    <TrimmerRootAssembly Include="System.Runtime.InteropServices.JavaScript" />
  </ItemGroup>
</Project>
