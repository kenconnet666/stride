<Project>
  <PropertyGroup>
    <StrideRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../'))</StrideRoot>
    <DirectoryPackagesPropsPath>$(StrideRoot)sources/Directory.Packages.props</DirectoryPackagesPropsPath>
  </PropertyGroup>
  <!-- A sample of the samples folder, built for the browser: -p:Sample=Graphics/SpriteFonts.
       Each sample has its own obj and bin folders. -->
  <PropertyGroup>
    <SampleName>$([System.IO.Path]::GetFileName('$(Sample)'))</SampleName>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/$(SampleName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin/$(SampleName)/</BaseOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFramework>$(StrideFramework)</TargetFramework>
    <TargetFramework Condition="'$(StridePlatforms)' == 'Browser'">$(StrideFrameworkBrowser)</TargetFramework>
    <!-- Serialized sample scripts use this assembly identity. -->
    <AssemblyName>$(SampleName).Game</AssemblyName>
    <RootNamespace>$(SampleName)</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The obj folders of the other samples are under this folder: only the files of the sample compile. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StrideSkipAutoPack>true</StrideSkipAutoPack>
    <StrideAssemblyProcessorFramework>net10.0</StrideAssemblyProcessorFramework>
    <SampleSource>$(StrideRoot)samples/$(Sample)/$(SampleName).Game/</SampleSource>
    <StrideCurrentPackagePath>$(SampleSource)$(SampleName).Game.sdpkg</StrideCurrentPackagePath>
    <StrideContainsAssetTypes>true</StrideContainsAssetTypes>
    <!-- Desktop preparation loads asset compilers; the browser ships runtime assemblies only. -->
    <StrideBuildCompanionProjects Condition="'$(StridePlatforms)' != 'Browser'">true</StrideBuildCompanionProjects>
  </PropertyGroup>
  <Target Name="CheckSample" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Sample)' == '' Or !Exists('$(SampleSource)$(SampleName).Game.sdpkg')" Text="Pass -p:Sample=&lt;folder under samples&gt;, for example Graphics/SpriteFonts." />
  </Target>
  <ItemGroup>
    <Compile Include="$(SampleSource)**/*.cs" Exclude="$(SampleSource)bin/**/*;$(SampleSource)obj/**/*" Link="Sample/%(RecursiveDir)%(Filename)%(Extension)" />
    <StrideShaderFiles Include="$(SampleSource)**/*.sdsl;$(SampleSource)**/*.sdfx" Exclude="$(SampleSource)bin/**/*;$(SampleSource)obj/**/*" />
    <StrideAssetNamespaceUsing Include="Stride.Engine" />
    <ProjectReference Include="$(StrideRoot)sources/engine/Stride.Engine/Stride.Engine.csproj" />
    <ProjectReference Include="$(StrideRoot)sources/plugins/UI/Stride.UI/Stride.UI.csproj" />
    <ProjectReference Include="$(StrideRoot)sources/plugins/Particles/Stride.Particles/Stride.Particles.csproj" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk/Sdk/Sdk.targets" />
</Project>
