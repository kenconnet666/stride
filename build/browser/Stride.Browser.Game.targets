<Project>
  <!-- What the browser head of a game needs and the engine packages do not carry yet. A head imports this file from the
       engine checkout its dev-redirect packages point to ($(StrideDevRoot)). It expects:
         - a reference to the game project, named <Game>.Game next to the head;
         - with the host of the samples (see StrideBrowserUseSampleHost), <AssemblyMetadata Include="Sample"
           Value="<Game>" /> : that host loads <Game>.Game by this name.
       It gives: the native libraries of the engine, and the content of the game compiled for WebGPU each time the head
       is built. The content is written into wwwroot/content of the head: "dotnet run" serves the wwwroot folder, and
       nothing else. It is generated: a head keeps it out of its repository. -->
  <PropertyGroup>
    <StrideBrowserRoot>$(MSBuildThisFileDirectory)</StrideBrowserRoot>
    <StrideBrowserHost>$(StrideBrowserRoot)Sample.Browser\</StrideBrowserHost>
    <!-- The native ports are those prepared for Space Escape (PrepareEmdawn.ps1, PrepareFreeType.ps1) -->
    <StrideBrowserNativePorts>$(StrideBrowserRoot)SpaceEscape.Browser\obj\</StrideBrowserNativePorts>
    <!-- With forward slashes: the link reads its options from a response file, where a backslash escapes -->
    <_StrideBrowserPorts>$(StrideBrowserNativePorts.Replace('\', '/'))</_StrideBrowserPorts>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) --use-port=$(_StrideBrowserPorts)emdawnwebgpu/emdawnwebgpu_pkg/emdawnwebgpu.port.py:cpp_bindings=false --use-port=$(_StrideBrowserPorts)freetype/stride-freetype.port.py</EmccExtraLDFlags>
    <StrideBrowserWebRoot>$(MSBuildProjectDirectory)\wwwroot\</StrideBrowserWebRoot>
    <StrideBrowserContentWork>$(MSBuildProjectDirectory)\obj\content\</StrideBrowserContentWork>
    <StrideBrowserContent>$(StrideBrowserWebRoot)content\</StrideBrowserContent>
    <!-- The effects the game asked the engine for in a browser run: recorded by validate-sample.cjs, compiled here -->
    <StrideBrowserEffectRequests Condition="'$(StrideBrowserEffectRequests)' == ''">$(MSBuildProjectDirectory)\effect-requests.json</StrideBrowserEffectRequests>
    <!-- Optional: the native WebGPU library the asset compiler renders with (a skybox is rendered when compiled) -->
    <StrideBrowserWebGpuNative Condition="'$(StrideBrowserWebGpuNative)' == ''">$(STRIDE_WEBGPU_NATIVE_LIBRARY)</StrideBrowserWebGpuNative>
    <StrideBrowserNaga Condition="'$(StrideBrowserNaga)' == ''">$(USERPROFILE)\.cargo\bin\naga.exe</StrideBrowserNaga>
  </PropertyGroup>

  <!-- A head with no Program.cs of its own gets the host of the samples: its program, and its page with what a
       validation reads. A head with its own program starts the game with Stride.Engine.BrowserGame and has its page. -->
  <PropertyGroup>
    <StrideBrowserUseSampleHost Condition="'$(StrideBrowserUseSampleHost)' == '' And !Exists('$(MSBuildProjectDirectory)\Program.cs')">true</StrideBrowserUseSampleHost>
  </PropertyGroup>
  <ItemGroup Condition="'$(StrideBrowserUseSampleHost)' == 'true'">
    <Compile Include="$(StrideBrowserHost)Program.cs" Link="Host\Program.cs" />
    <Compile Include="$(StrideBrowserRoot)SpaceEscape.Browser\EffectRequestRecorder.cs" Link="Host\EffectRequestRecorder.cs" />
    <StrideBrowserHostFile Include="$(StrideBrowserHost)wwwroot\**\*" />
  </ItemGroup>
  <ItemGroup>
    <StrideBrowserHostFile Include="$(StrideBrowserRoot)Shared\FreeType-LICENSE.txt" />
    <StrideBrowserHostFile Include="$(StrideBrowserRoot)CWebGpuProbe\wwwroot\THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <Target Name="StrideBrowserCheckInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(StrideBrowserNativePorts)emdawnwebgpu\emdawnwebgpu_pkg\emdawnwebgpu.port.py')" Text="Run build/browser/PrepareEmdawn.ps1 -Project SpaceEscape.Browser in the engine checkout." />
    <Error Condition="!Exists('$(StrideBrowserNativePorts)freetype\stride-freetype.port.py')" Text="Run build/browser/PrepareFreeType.ps1 -Project SpaceEscape.Browser in the engine checkout." />
    <Error Condition="!Exists('$(StrideBrowserNaga)')" Text="Naga 30.0.2 was not found at $(StrideBrowserNaga): set StrideBrowserNaga." />
  </Target>

  <!-- The game is built by now (its reference is resolved): write the page, compile the assets of the game for WebGPU
       and package them. MSBuild read the items of wwwroot before this ran: they are read again. -->
  <Target Name="StrideBrowserPrepareWebRoot" DependsOnTargets="ResolveProjectReferences" BeforeTargets="AssignTargetPaths;ResolveProjectStaticWebAssets;ResolveStaticWebAssetsInputs">
    <Copy SourceFiles="@(StrideBrowserHostFile)" DestinationFiles="@(StrideBrowserHostFile->'$(StrideBrowserWebRoot)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_StrideBrowserGame Include="@(_ResolvedProjectReferencePaths)" Condition="$([System.String]::Copy('%(Filename)').EndsWith('.Game'))" />
    </ItemGroup>
    <Error Condition="'@(_StrideBrowserGame)' == ''" Text="The browser head references no game project (a project named &lt;Game&gt;.Game)." />
    <PropertyGroup>
      <_StrideBrowserGameAssembly>%(_StrideBrowserGame.FullPath)</_StrideBrowserGameAssembly>
      <_StrideBrowserGameProject>%(_StrideBrowserGame.MSBuildSourceProjectFile)</_StrideBrowserGameProject>
      <_StrideBrowserGameName>$([System.IO.Path]::GetFileNameWithoutExtension('$(_StrideBrowserGameProject)'))</_StrideBrowserGameName>
      <_StrideBrowserGameFramework>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('$(_StrideBrowserGameAssembly)'))))</_StrideBrowserGameFramework>
      <_StrideBrowserManifest>$([System.IO.Path]::GetDirectoryName('$(_StrideBrowserGameProject)'))\obj\$(Configuration)\$(_StrideBrowserGameFramework)\$(_StrideBrowserGameName).sdbuild</_StrideBrowserManifest>
    </PropertyGroup>
    <Error Condition="!Exists('$(_StrideBrowserManifest)')" Text="The game project has no asset build manifest at $(_StrideBrowserManifest)." />
    <Exec Condition="'$(StrideBrowserSkipContent)' != 'true'" Command="pwsh -NoProfile -File &quot;$(StrideBrowserRoot)PrepareGameContent.ps1&quot; -Manifest &quot;$(_StrideBrowserManifest)&quot; -GameAssembly &quot;$(_StrideBrowserGameAssembly)&quot; -Output &quot;$(StrideBrowserContent.TrimEnd('\'))&quot; -Work &quot;$(StrideBrowserContentWork.TrimEnd('\'))&quot; -Naga &quot;$(StrideBrowserNaga)&quot; -EffectRequests &quot;$(StrideBrowserEffectRequests)&quot; -WebGpuNative &quot;$(StrideBrowserWebGpuNative)&quot; -Configuration $(Configuration)" />
    <ItemGroup>
      <Content Remove="wwwroot\**" />
      <Content Include="wwwroot\**" />
    </ItemGroup>
  </Target>

  <!-- The symbols of an assembly that a dev-redirect package replaces come with the destination of the assembly itself
       (Stride.Engine.pdb to "Stride.Engine.dll"). The WebAssembly build names its files by that destination: the symbols
       would take the place of the assembly, which is then dropped as a duplicate. -->
  <Target Name="StrideBrowserFixSymbolDestinations" DependsOnTargets="ResolveReferences" BeforeTargets="_GatherWasmFilesToBuild;_ComputeWasmBuildCandidates">
    <ItemGroup>
      <_StrideBrowserSymbols Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.pdb' And '%(ReferenceCopyLocalPaths.DestinationSubPath)' == '%(ReferenceCopyLocalPaths.Filename).dll'" />
      <ReferenceCopyLocalPaths Remove="@(_StrideBrowserSymbols)" />
      <ReferenceCopyLocalPaths Include="@(_StrideBrowserSymbols)">
        <DestinationSubPath>%(_StrideBrowserSymbols.Filename).pdb</DestinationSubPath>
      </ReferenceCopyLocalPaths>
    </ItemGroup>
  </Target>

  <!-- What of the engine does not run in a browser, said where the game uses it. VR is not in the list: Stride.Engine
       brings Stride.VirtualReality to every game. -->
  <ItemGroup>
    <StrideBrowserUnsupported Include="Stride.Physics" Reason="Bullet physics is a native library with no WebAssembly build: use Stride.BepuPhysics" />
    <StrideBrowserUnsupported Include="Stride.Video" Reason="video playback has no browser implementation" />
    <StrideBrowserUnsupported Include="Stride.SpriteStudio.Runtime" Reason="SpriteStudio was not tried in a browser" />
  </ItemGroup>
  <Target Name="StrideBrowserWarnUnsupported" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_StrideBrowserUsed Include="@(ReferencePath->'%(Filename)')" />
      <_StrideBrowserUnsupportedUnused Include="@(StrideBrowserUnsupported)" Exclude="@(_StrideBrowserUsed)" />
      <_StrideBrowserUnsupportedUsed Include="@(StrideBrowserUnsupported)" Exclude="@(_StrideBrowserUnsupportedUnused)" />
    </ItemGroup>
    <Warning Code="STRIDEWEB001" Condition="'@(_StrideBrowserUnsupportedUsed)' != ''" Text="The game uses %(_StrideBrowserUnsupportedUsed.Identity), which does not work in a browser: %(_StrideBrowserUnsupportedUsed.Reason)." />
  </Target>

  <!-- A game that references Stride.Audio links the native audio library of the engine, over the OpenAL of Emscripten -->
  <Target Name="StrideBrowserLinkAudio" DependsOnTargets="ResolveReferences" BeforeTargets="_WasmCommonPrepareForWasmBuildNative" Condition="'$(WasmBuildNative)' == 'true'">
    <PropertyGroup Condition="'@(ReferencePath->WithMetadataValue('Filename', 'Stride.Audio'))' != ''">
      <EmccExtraLDFlags>$(EmccExtraLDFlags) --use-port=$(StrideBrowserRoot.Replace('\', '/'))Shared/stride-audio.port.py -lopenal</EmccExtraLDFlags>
      <_StrideBrowserAudio>true</_StrideBrowserAudio>
    </PropertyGroup>
    <ItemGroup Condition="'$(_StrideBrowserAudio)' == 'true'">
      <_WasmPInvokeModules Include="libstrideaudio" />
    </ItemGroup>
  </Target>

  <!-- A port supplies its library at the final link instead of a NativeFileReference: the P/Invoke table generator of
       the pinned SDK needs the names of the modules. -->
  <Target Name="StrideBrowserRegisterStaticModules" BeforeTargets="_GenerateManagedToNative">
    <ItemGroup>
      <!-- The engine packages are packed for the desktop and bring the SDL bindings, whose callbacks the P/Invoke scan
           rejects. The browser build of the engine never calls them: the scan leaves the assembly out. -->
      <_WasmAssembliesInternal Remove="@(_WasmAssembliesInternal)" Condition="'%(Filename)' == 'Silk.NET.SDL'" />
      <_WasmPInvokeModules Include="wgpu_native" />
      <_WasmPInvokeModules Include="freetype" />
    </ItemGroup>
  </Target>
</Project>
